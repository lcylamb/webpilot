# ===== LLM（必填，选一个） =====
# 推荐：DeepSeek（便宜、OpenAI 兼容、国内可直接用）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 或者：通义千问 Qwen（DashScope 兼容模式）
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ===== Agent 限制 =====
MAX_STEPS=10
OVERALL_TIMEOUT_MS=180000
STEP_TIMEOUT_MS=45000
MAX_REFLECTIONS=3      # 失败反思重试次数上限

# ===== 任务记忆（RAG，可选） =====
# MEMORY_TOP_K=3          # 每次召回的相似经验条数
# MEMORY_MIN_SCORE=0.55   # 相似度阈值（低于不注入）
# MEMORY_DIR=data         # 记忆库存放目录

# ===== 安全护栏：域名白名单（逗号分隔，含子域名） =====
ALLOWED_DOMAINS=localhost,127.0.0.1,example.com

# ===== 访问口令（公网部署时必须设置） =====
# 设置后所有 /api/agent 请求必须带 x-webpilot-token 头，防止陌生流量烧 LLM 额度。
# 本地开发留空即不启用。
# ACCESS_TOKEN=change-me-to-a-long-random-string

# ===== MCP 工具生态（可选）=====
# Agent 启动时连接的外部 MCP server（stdio），工具以 mcp__<name>__<tool> 并入工具箱
# WEBPILOT_MCP_SERVERS=[{"name":"browser","command":"npx","args":["tsx","mcp/server.ts"]}]
